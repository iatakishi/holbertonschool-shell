#!/usr/bin/env bash
# Creates /var/run/myscript.pid; handles signals; cleans up; loops.

PIDFILE="/var/run/myscript.pid"

# create pidfile or fail (no sudo, inside-file only)
if ! printf '%s\n' "$$" >"$PIDFILE" 2>/dev/null; then
  echo "Permission denied: $PIDFILE" >&2
  exit 1
fi

cleanup(){ rm -f "$PIDFILE"; exit 0; }

trap 'echo "I hate the kill command"; cleanup' SIGTERM
trap 'echo "Y U no love me?!";' SIGINT
trap 'cleanup' SIGQUIT

while true; do
  echo "To infinity and beyond"
  sleep 2
done
