#!/usr/bin/env bash
# Process and PID file.
pid=$(pgrep -f 10-process_and_pid_file)
echo "$pid" > myscript.pid
sudo mv ./myscript.pid /var/run/
while ((1)); do
    echo "To infinity and beyond"
    trap 'echo "I hate the kill command" && sudo rm "/var/run/myscript.pid" && kill -SIGKILL $pid' SIGTERM
    trap 'echo "Y U no love me?!"' SIGINT
done
