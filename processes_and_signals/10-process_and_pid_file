#!/usr/bin/env bash
PIDFILE="/var/run/myscript.pid"

# Create pidfile; fallback to sudo if needed (non-interactive if allowed)
if ! echo "$$" > "$PIDFILE" 2>/dev/null; then
  echo "$$" | sudo -n tee "$PIDFILE" >/dev/null || exit 1
fi

cleanup_and_exit() {
  rm -f "$PIDFILE" 2>/dev/null || sudo -n rm -f "$PIDFILE"
  exit 0
}

trap 'echo "I hate the kill command"; cleanup_and_exit' SIGTERM
trap 'echo "Y U no love me?!";' SIGINT
trap 'cleanup_and_exit' SIGQUIT

while true; do
  echo "To infinity and beyond"
  sleep 2
done

